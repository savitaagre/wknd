coverage/*
logs/*
node_modules/*

helix-importer-ui
.DS_Store
*.bak
.idea

# Ensure these files are tracked
!CLAUDE.md
!AGENTS.md
migration-work/navigation-validation/
migration-work/footer-validation/

# migration scratch + local backups (project-local, not repo content)
.migration/

# generated import artifacts (rebuilt from tools/importer/import-*.js sources)
tools/importer/*.bundle.js
tools/importer/reports/

# >>> stardust
.env
.env.*
# <<< stardust

# byte copy of the stardust plugin-root deps so the stardust/scripts copies resolve (never npm-installed into the project)
stardust/scripts/node_modules/

# local config backups taken before remote changes (never committed)
stardust/wknd-rename/

# git bundles for manual pushes (never commit)
docs/*.bundle
