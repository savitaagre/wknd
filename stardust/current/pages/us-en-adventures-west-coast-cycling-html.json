            {
              "type": "image",
              "src": "https://wknd.site/us/en/adventures/west-coast-cycling/_jcr_content/root/container/container_fixed/tabs/item_1594238312974/par0/image.coreimg.jpeg/1660323770243/mountain-biking.jpeg",
