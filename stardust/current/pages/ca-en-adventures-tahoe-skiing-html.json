            {
              "type": "image",
              "src": "https://wknd.site/ca/en/adventures/tahoe-skiing/_jcr_content/root/container/container_fixed/tabs/item_1594238312974/par0/image.coreimg.jpeg/1660323770289/adobestock-224653243.jpeg",
